/* ==========================================================================
   PriRex Auditor — тема оформления
   Палитра приглушённая: тёплый светло-серый фон, шалфейно-зелёный акцент,
   пыльные статусные цвета. Никакой системной синевы Qt.
   Плейсхолдер {assets} подставляется в app/ui/theme.py на путь к assets.
   ========================================================================== */

QWidget {
    background-color: transparent;
    color: #2E2E2E;
    font-size: 13px;
}

QMainWindow,
QDialog,
QWidget#Root {
    background-color: #F2F0EC;
}

/* --- подписи ------------------------------------------------------------ */
QLabel {
    background: transparent;
    color: #2E2E2E;
}

QLabel#AppTitle {
    color: #4A463F;
    font-size: 17px;
    font-weight: 600;
}

QLabel#AppSubtitle {
    color: #8C877E;
    font-size: 12px;
}

QLabel#SectionTitle {
    color: #4A463F;
    font-size: 13px;
    font-weight: 600;
}

QLabel#Muted {
    color: #8C877E;
    font-size: 12px;
}

QLabel#Hint {
    color: #8C877E;
    font-size: 11px;
}

QLabel#ScoreValue {
    color: #4A463F;
    font-size: 44px;
    font-weight: 600;
}

QLabel#ScoreValue[level="good"] { color: #6E8F72; }
QLabel#ScoreValue[level="ok"]   { color: #8E9A6E; }
QLabel#ScoreValue[level="warn"] { color: #B59A5F; }
QLabel#ScoreValue[level="bad"]  { color: #B0786D; }

QLabel#ScoreTitle {
    color: #4A463F;
    font-size: 13px;
    font-weight: 600;
}

QLabel#ScoreHint {
    color: #8C877E;
    font-size: 11px;
}

/* --- чипы статусов ------------------------------------------------------ */
QLabel#Chip {
    border-radius: 10px;
    padding: 2px 9px;
    font-size: 11px;
    font-weight: 600;
    background-color: #E9E5DE;
    color: #6E6A63;
}

QLabel#Chip[chip="pass"] { background-color: #E6EEE4; color: #52704F; }
QLabel#Chip[chip="warn"] { background-color: #F5EEDA; color: #8A7137; }
QLabel#Chip[chip="fail"] { background-color: #F3E2DE; color: #8E5449; }
QLabel#Chip[chip="skip"] { background-color: #E8ECF0; color: #5C6875; }
QLabel#Chip[chip="na"]   { background-color: #F8EBDB; color: #966C39; }

/* --- карточки ----------------------------------------------------------- */
QFrame#Card,
QFrame#Panel {
    background-color: #FBFAF7;
    border: 1px solid #E4E0D8;
    border-radius: 8px;
}

QFrame#Footer {
    background-color: #FBFAF7;
    border-top: 1px solid #E0DDD8;
}

QFrame#DetailHeader {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid #E4E0D8;
}

QFrame#HLine {
    background-color: #E4E0D8;
    border: none;
    max-height: 1px;
    min-height: 1px;
}

/* --- поле ввода URL ----------------------------------------------------- */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #D6D2CB;
    border-radius: 6px;
    padding: 6px 10px;
    color: #2E2E2E;
    selection-background-color: #C9D8C7;
    selection-color: #2E2E2E;
}

QLineEdit:hover {
    border-color: #C4BFB6;
}

QLineEdit:focus {
    border-color: #7A9A7E;
}

QLineEdit#UrlInput {
    font-size: 14px;
    padding: 9px 12px;
    border-radius: 7px;
}

QLineEdit:disabled {
    background-color: #EFEBE5;
    color: #A5A099;
}

/* --- кнопки ------------------------------------------------------------- */
QPushButton {
    background-color: #7A9A7E;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #6B8A6F;
}

QPushButton:pressed {
    background-color: #5D7A61;
}

QPushButton:disabled {
    background-color: #C9CFC7;
    color: #F4F2EE;
}

QPushButton#PrimaryButton {
    background-color: #7A9A7E;
    color: #FFFFFF;
    min-height: 20px;
}

QPushButton#PrimaryButton:hover { background-color: #6B8A6F; }

QPushButton#SecondaryButton {
    background-color: #FFFFFF;
    color: #4A463F;
    border: 1px solid #D6D2CB;
    font-weight: 500;
}

QPushButton#SecondaryButton:hover {
    background-color: #F6F4EF;
    border-color: #C4BFB6;
}

QPushButton#SecondaryButton:pressed {
    background-color: #EDE9E2;
}

QPushButton#SecondaryButton:disabled {
    background-color: #F2EFE9;
    color: #B5B0A8;
    border-color: #E4E0D8;
}

QPushButton#GhostButton {
    background-color: transparent;
    color: #6B7F99;
    border: none;
    padding: 6px 8px;
    font-weight: 500;
}

QPushButton#GhostButton:hover {
    background-color: #EAE7E0;
    color: #5A6C83;
}

QPushButton#GhostButton:disabled {
    background-color: transparent;
    color: #B5B0A8;
}

/* --- чекбоксы ----------------------------------------------------------- */
QCheckBox {
    spacing: 7px;
    color: #4A463F;
    font-size: 12px;
    background: transparent;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #C9C4BB;
    border-radius: 4px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:hover {
    border-color: #A9BCA7;
}

QCheckBox::indicator:checked {
    background-color: #7A9A7E;
    border-color: #7A9A7E;
    image: url("{assets}/icons/checkbox-check.svg");
}

QCheckBox::indicator:disabled {
    background-color: #EFEBE5;
    border-color: #DED9D1;
}

/* --- прогресс ----------------------------------------------------------- */
QProgressBar {
    background-color: #E7E3DC;
    border: none;
    border-radius: 3px;
    height: 6px;
    max-height: 6px;
    min-height: 6px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #7A9A7E;
    border-radius: 3px;
}

QLabel#ProgressLabel {
    color: #8C877E;
    font-size: 11px;
}

/* --- дерево проверок ---------------------------------------------------- */
QTreeWidget,
QTreeView {
    background-color: transparent;
    border: none;
    outline: 0;
    show-decoration-selected: 0;
    alternate-background-color: transparent;
}

QTreeWidget#CheckTree::item,
QTreeWidget#NaTree::item {
    padding: 6px 4px;
    border-radius: 5px;
    color: #2E2E2E;
}

QTreeWidget#CheckTree::item:hover,
QTreeWidget#NaTree::item:hover {
    background-color: #F0EDE6;
}

QTreeWidget#CheckTree::item:selected,
QTreeWidget#NaTree::item:selected {
    background-color: #E6EDE4;
    color: #2E2E2E;
}

QTreeWidget#CheckTree::item:selected:!active,
QTreeWidget#NaTree::item:selected:!active {
    background-color: #E6EDE4;
    color: #2E2E2E;
}


QHeaderView::section {
    background-color: transparent;
    color: #8C877E;
    border: none;
    border-bottom: 1px solid #E4E0D8;
    padding: 6px 4px;
    font-size: 11px;
    font-weight: 600;
}

/* --- правая панель деталей ---------------------------------------------- */
QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QLabel#DetailTitle {
    color: #4A463F;
    font-size: 16px;
    font-weight: 600;
}

QLabel#DetailSection {
    color: #8C877E;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.6px;
}

QLabel#DetailBody {
    color: #2E2E2E;
    font-size: 12px;
}

QLabel#DetailMuted {
    color: #6E6A63;
    font-size: 12px;
}

QLabel#DetailRecommendation {
    background-color: #F2F4EF;
    border-left: 3px solid #7A9A7E;
    border-radius: 4px;
    padding: 9px 11px;
    color: #3F4A3F;
    font-size: 12px;
}

QLabel#DetailNa {
    background-color: #FAF0E3;
    border-left: 3px solid #D9A46B;
    border-radius: 4px;
    padding: 9px 11px;
    color: #6E5535;
    font-size: 12px;
}

QTextBrowser#DetailText {
    background-color: transparent;
    border: none;
    color: #2E2E2E;
    font-size: 12px;
}

/* --- сворачиваемая секция N/A ------------------------------------------- */
QToolButton#NaToggle {
    background-color: transparent;
    border: none;
    color: #6E6A63;
    font-size: 12px;
    font-weight: 600;
    text-align: left;
    padding: 6px 4px;
    border-radius: 5px;
}

QToolButton#NaToggle:hover {
    background-color: #EDEAE4;
    color: #4A463F;
}

/* --- служебное ---------------------------------------------------------- */
QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:horizontal {
    width: 10px;
}

QScrollBar:vertical {
    background: transparent;
    width: 9px;
    margin: 2px 1px 2px 1px;
}

QScrollBar::handle:vertical {
    background-color: #D6D2CB;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #C2BDB4;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: transparent;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 9px;
    margin: 1px 2px 1px 2px;
}

QScrollBar::handle:horizontal {
    background-color: #D6D2CB;
    border-radius: 4px;
    min-width: 28px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: transparent;
}

QMenuBar {
    background-color: #F2F0EC;
    color: #4A463F;
    padding: 2px 4px;
    border-bottom: 1px solid #E4E0D8;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #E6EDE4;
    color: #2E2E2E;
}

QMenu {
    background-color: #FBFAF7;
    border: 1px solid #E0DDD8;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 22px 6px 14px;
    border-radius: 4px;
    color: #2E2E2E;
}

QMenu::item:selected {
    background-color: #E6EDE4;
    color: #2E2E2E;
}

QMenu::separator {
    height: 1px;
    background-color: #E4E0D8;
    margin: 4px 8px;
}

QStatusBar {
    background-color: #FBFAF7;
    border-top: 1px solid #E0DDD8;
    color: #6E6A63;
    font-size: 11px;
}

QToolTip {
    background-color: #4A463F;
    color: #F5F2ED;
    border: none;
    border-radius: 5px;
    padding: 5px 8px;
    font-size: 11px;
}

QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #D6D2CB;
    border-radius: 6px;
    padding: 5px 8px;
    min-height: 18px;
    color: #2E2E2E;
}

QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #C4BFB6;
}

QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #7A9A7E;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #FBFAF7;
    border: 1px solid #E0DDD8;
    border-radius: 6px;
    selection-background-color: #E6EDE4;
    selection-color: #2E2E2E;
    padding: 3px;
    outline: 0;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    background-color: transparent;
    border: none;
    width: 16px;
}

QGroupBox {
    border: 1px solid #E4E0D8;
    border-radius: 8px;
    margin-top: 14px;
    padding-top: 10px;
    color: #4A463F;
    font-weight: 600;
    background-color: #FBFAF7;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
    color: #4A463F;
    font-size: 12px;
}

QDialog#AboutDialog,
QDialog#SettingsDialog {
    background-color: #F2F0EC;
}

QLabel#AboutName {
    color: #4A463F;
    font-size: 15px;
    font-weight: 600;
}

QLabel#AboutVersion {
    color: #8C877E;
    font-size: 11px;
}

QLabel#AboutDisclaimer {
    color: #8C877E;
    font-size: 10px;
}

QPushButton#LinkButton {
    background: transparent;
    border: none;
    color: #6B7F99;
    font-size: 12px;
    font-weight: 500;
    padding: 0;
    text-align: left;
}

/* ==========================================================================
   Дополнительные стили: тулбар, справочные окна, Boosty, заключение
   ========================================================================== */

/* --- тулбар главного окна ------------------------------------------------ */
QWidget#Toolbar {
    background: transparent;
}

QLabel#VersionLabel {
    color: #8C877E;
    font-size: 11px;
    background: transparent;
}

QPushButton#howItWorksButton {
    background: transparent;
    border: none;
    color: #6E6A63;
    font-size: 12px;
    padding: 4px 8px;
    border-radius: 5px;
    text-align: left;
}

QPushButton#howItWorksButton:hover {
    color: #6B7F99;
    background-color: #EAE7E0;
}

QPushButton#methodologyButton {
    background-color: #FFFFFF;
    border: 1px solid #D6D2CB;
    border-radius: 6px;
    color: #4A463F;
    padding: 9px 14px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#methodologyButton:hover {
    background-color: #F6F4EF;
    border-color: #C4BFB6;
}

QPushButton#methodologyButton:pressed {
    background-color: #EDE9E2;
}

QLabel#FooterSeparator {
    color: #C9C4BB;
    font-size: 12px;
    background: transparent;
}

/* --- кнопка Boosty (пилюля) --------------------------------------------- */
QPushButton#boostyButton {
    background-color: transparent;
    border: 1px solid #D9A46B;
    border-radius: 12px;
    color: #B87A6E;
    font-size: 12px;
    font-weight: 500;
    padding: 3px 10px;
}

QPushButton#boostyButton:hover {
    background-color: rgba(243, 228, 214, 0.6);
}

QPushButton#boostyButton:pressed {
    background-color: #F3E4D6;
}

/* --- окна справочников --------------------------------------------------- */
QDialog#MethodologyWindow,
QDialog#HowItWorksWindow {
    background-color: #F2F0EC;
}

QLabel#MethodologyTitle {
    color: #4A463F;
    font-size: 18px;
    font-weight: 600;
}

QLabel#MethodologySubtitle {
    color: #8C877E;
    font-size: 11px;
}

QLabel#PillBadge {
    background-color: #F8EBDB;
    color: #966C39;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#LegalBasis {
    background-color: #F7F3EA;
    border-left: 3px solid #C9A96A;
    border-radius: 4px;
    padding: 8px 11px;
    color: #4A463F;
    font-size: 12px;
}

QLabel#InfoSectionLabel {
    color: #8C877E;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.6px;
}

QLabel#InfoBody {
    color: #2E2E2E;
    font-size: 12px;
}

QLabel#EmptyState {
    color: #8C877E;
    font-size: 12px;
}

QTreeWidget#methodologyTree {
    background-color: transparent;
    border: none;
    outline: 0;
}

QTreeWidget#methodologyTree::item {
    padding: 6px 4px;
    border-radius: 5px;
    color: #2E2E2E;
}

QTreeWidget#methodologyTree::item:hover {
    background-color: #F0EDE6;
}

QTreeWidget#methodologyTree::item:selected {
    background-color: #E6EDE4;
    color: #2E2E2E;
}

QListWidget#howItWorksNav {
    background-color: transparent;
    border: none;
    outline: 0;
}

QListWidget#howItWorksNav::item {
    padding: 8px 10px;
    border-radius: 6px;
    color: #4A463F;
    font-size: 12px;
}

QListWidget#howItWorksNav::item:hover {
    background-color: #F0EDE6;
}

QListWidget#howItWorksNav::item:selected {
    background-color: #E6EDE4;
    color: #2E2E2E;
}

QTextBrowser#howItWorksContent {
    background-color: #FBFAF7;
    border: 1px solid #E4E0D8;
    border-radius: 8px;
    padding: 14px;
    color: #2E2E2E;
    font-size: 13px;
}

/* --- окно «Заключение» --------------------------------------------------- */
QDialog#ConclusionDialog {
    background-color: #F2F0EC;
}

QLabel#ConclusionTitle {
    color: #4A463F;
    font-size: 17px;
    font-weight: 600;
}

QLabel#ConclusionHint {
    color: #8C877E;
    font-size: 11px;
}

QFrame#ConclusionItem {
    background-color: #FBFAF7;
    border: 1px solid #E4E0D8;
    border-radius: 7px;
}

QLabel#ConclusionItemTitle {
    color: #4A463F;
    font-size: 12px;
    font-weight: 600;
}

QLabel#ConclusionItemText {
    color: #6E6A63;
    font-size: 11px;
}

QLabel#ConclusionGain {
    color: #B87A6E;
    font-size: 11px;
    font-weight: 600;
}